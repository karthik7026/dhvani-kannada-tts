# Optional: enables Groq semantic phrase-direction before the local prosody mapper.
# Keep this file as a template; put the real value in your shell or an untracked .env file.
GROQ_API_KEY=
# Optional override; the default is openai/gpt-oss-20b.
GROQ_SPEECH_DIRECTOR_MODEL=openai/gpt-oss-20b
# Semantic labels are deliberately subtle. 0.0 preserves pure Edge TTS delivery.
SEMANTIC_PROSODY_STRENGTH=0.18
